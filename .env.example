# Dashboard operator configuration. Generate tokens with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DATABASE_URL=postgresql://qa_dashboard:change-me@127.0.0.1:5432/qa_dashboard
OPERATOR_TOKEN=
POSTGRES_PASSWORD=
TARGET_ALLOWLIST=http://127.0.0.1:4173
RUNS_DIR=.runs
RUN_TIMEOUT_MS=600000
HOST=127.0.0.1
PORT=3001
COOKIE_SECURE=false
DASHBOARD_PORT=8080
API_INTERNAL_URL=http://127.0.0.1:3001

# Existing legacy suites only; never commit credentials.
EUREKABOOKHOUSE_EMAIL=user@example.com
EUREKABOOKHOUSE_PASSWORD=

JAJA_EMAIL=user@example.com
JAJA_PASSWORD=

MASTERDISKON_EMAIL=user@example.com
MASTERDISKON_PASSWORD=