# Konfigurasi Playbook. Salin ke .env, jangan commit .env.
# SQLite file database; tidak butuh server DB terpisah.
DATABASE_URL=sqlite:./data/playbook.db
# Origin yang boleh jadi target run (persis, tanpa path).
TARGET_ALLOWLIST=http://127.0.0.1:4173
RUNS_DIR=.runs
REPORTS_DIR=.reports
RUN_TIMEOUT_MS=600000
HOST=127.0.0.1
PORT=3001
COOKIE_SECURE=false
API_INTERNAL_URL=http://127.0.0.1:3001

# Kredensial akun test untuk spec yang login (jangan commit nilainya).
EUREKABOOKHOUSE_EMAIL=
EUREKABOOKHOUSE_PASSWORD=
JAJA_EMAIL=
JAJA_PASSWORD=
MASTERDISKON_EMAIL=
MASTERDISKON_PASSWORD=