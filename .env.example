# Konfigurasi Playbook. Salin ke .env, jangan commit .env.
# SQLite file database; tidak butuh server DB terpisah.
DATABASE_URL=sqlite:./data/playbook.db
# Origin yang boleh jadi target run (persis, tanpa path).
# Allowlist wajib, tanpa wildcard. Isi origin persis (skema+host+port).
# env=local ikut dicek. Kalau dashboard dihosting dan target lokal dibuka lewat
# tunnel (cloudflared/ngrok), tambahkan origin tunnel itu di sini atau di
# origins project — jangan pernah memakai wildcard.
TARGET_ALLOWLIST=http://127.0.0.1:4173,http://localhost:3000,http://127.0.0.1:3000,https://localhost:5173,https://127.0.0.1:5173,http://127.0.0.1:5173
RUNS_DIR=.runs
REPORTS_DIR=.reports
RUN_TIMEOUT_MS=900000
# Retensi harian (PRD §8.6). 0 = nonaktif; kalau aktif jangan jalankan
# `npm run retention` dari cron sekaligus. 86400000 = sekali sehari.
RETENTION_INTERVAL_MS=86400000
# Backup SQLite otomatis. Wajib ≤ RETENTION_INTERVAL_MS (A60).
BACKUP_INTERVAL_MS=86400000
# Folder + jumlah hari simpan backup (default data/backups, 7 hari).
BACKUP_DIR=
BACKUP_KEEP_DAYS=7
HOST=127.0.0.1
PORT=3001
COOKIE_SECURE=false
API_INTERNAL_URL=http://127.0.0.1:3001

# Kredensial akun test untuk spec yang login (jangan commit nilainya).
EUREKABOOKHOUSE_EMAIL=
EUREKABOOKHOUSE_PASSWORD=
JAJA_EMAIL=
JAJA_PASSWORD=
MASTERDISKON_EMAIL=
MASTERDISKON_PASSWORD=