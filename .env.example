# Dashboard account configuration. The first registered account becomes admin.
# Create all accounts before switching ALLOW_REGISTRATION to false.
# SQLite file database; no separate server is needed. Absolute paths are safer for services.
DATABASE_URL=sqlite:./data/qa.db
ALLOW_REGISTRATION=true
TARGET_ALLOWLIST=http://127.0.0.1:4173
RUNS_DIR=.runs
RUN_TIMEOUT_MS=600000
HOST=127.0.0.1
PORT=3001
COOKIE_SECURE=false
DASHBOARD_PORT=8080
API_INTERNAL_URL=http://127.0.0.1:3001

# Existing legacy suites only; never commit credentials.
EUREKABOOKHOUSE_EMAIL=user@example.com
EUREKABOOKHOUSE_PASSWORD=

JAJA_EMAIL=user@example.com
JAJA_PASSWORD=

MASTERDISKON_EMAIL=user@example.com
MASTERDISKON_PASSWORD=