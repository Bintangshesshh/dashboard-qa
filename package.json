{
  "name": "dashboard-qa",
  "version": "1.0.0",
  "description": "QA dashboard - Playwright + Lighthouse CI (Eureka Group: jaja, masdis, ebh)",
  "main": "index.js",
  "bin": {
    "playbook": "bin/playbook.mjs"
  },
  "scripts": {
    "test": "npm test --prefix server",
    "test:md": "node scripts/test-report-md.mjs",
    "test:report": "node scripts/test-report-html.mjs",
    "test:integration": "node scripts/verify-dashboard.mjs",
    "fixture": "node scripts/local-fixture.mjs",
    "dev:web": "npm run dev --prefix web",
    "dev:server": "node --experimental-sqlite --env-file=.env server/index.mjs",
    "retention": "node --experimental-sqlite --env-file=.env scripts/retention.mjs",
    "backup": "node --experimental-sqlite --env-file=.env scripts/backup.mjs",
    "playbook": "node bin/playbook.mjs",
    "build": "npm run build --prefix web"
  },
  "keywords": [],
  "type": "commonjs",
  "devDependencies": {
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.63.0",
    "typescript": "^7.0.2"
  }
}
